sh -c 'case "$GC_SESSION_ORIGIN" in ephemeral|named|"") ;; *) [ -n "$GC_ALIAS" ] && [ "$1" = "$GC_ALIAS" ] || exit 0 ;; esac; probe_pool_demand() { target="$1"; [ -z "$target" ] && return 1; r=$(bd ready --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-type=message --exclude-label "hold:mayor" --exclude-label "hold:external" --json --limit=20 2>/dev/null); gc_pool_window="$r"; gc_preferred_pool_demand=$(printf "%s" "$r" | jq -c '\''[.[] | select(((((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "workflow") and (((.metadata["gc.workflow_expanded"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "true")) | not)] | ([.[] | select((((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.formula_contract"] // "") == "graph.v2")) | not)] + [.[] | select(((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.formula_contract"] // "") == "graph.v2"))]) | .[:20]'\'' 2>/dev/null); [ -n "$gc_preferred_pool_demand" ] && r="$gc_preferred_pool_demand"; if [ "$r" = "[]" ] && [ "$(printf "%s" "$gc_pool_window" | jq -r '\''length >= 20'\'' 2>/dev/null)" = "true" ]; then r=$(bd ready --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-type=message --exclude-label "hold:mayor" --exclude-label "hold:external" --json --limit=0 2>/dev/null); gc_preferred_pool_demand=$(printf "%s" "$r" | jq -c '\''[.[] | select(((((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "workflow") and (((.metadata["gc.workflow_expanded"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "true")) | not)] | ([.[] | select((((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.formula_contract"] // "") == "graph.v2")) | not)] + [.[] | select(((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.formula_contract"] // "") == "graph.v2"))]) | .[:20]'\'' 2>/dev/null); [ -n "$gc_preferred_pool_demand" ] && r="$gc_preferred_pool_demand"; fi; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_candidates=$(bd ready --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-type=message --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort oldest --limit=20 2>/dev/null); r=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select(((((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "workflow") and (((.metadata["gc.workflow_expanded"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "true")) | not)] | [.[] | select((.metadata["gc.routed_to"] // "") == "")] | .[:1]'\'' 2>/dev/null); if [ "$r" = "[]" ] && [ "$(printf "%s" "$legacy_candidates" | jq -r '\''length >= 20'\'' 2>/dev/null)" = "true" ]; then legacy_candidates=$(bd ready --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-type=message --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort oldest --limit=0 2>/dev/null); r=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select(((((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "workflow") and (((.metadata["gc.workflow_expanded"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "true")) | not)] | [.[] | select((.metadata["gc.routed_to"] // "") == "")] | .[:1]'\'' 2>/dev/null); fi; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_ephemeral_candidates=$({ bd query --json '\''ephemeral=true AND status=open'\'' --limit=0 2>/dev/null | jq --arg target "$target" '\''[.[] | select((.assignee // "") == "") | select(((.metadata["gc.routed_to"] // "") == $target) or (((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.run_target"] // "") == $target) and ((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.workflow_expanded"] // "") != "true"))) | select(((.issue_type // .type // "") != "epic")) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length) == 0) | select(((.dependency_count // 0) == 0))] | sort_by(.created_at // "", .id // "") | [.[] | select(((((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "workflow") and (((.metadata["gc.workflow_expanded"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "true")) | not)] | .[:20]'\'' 2>/dev/null; } || printf "[]"); r=$(printf "%s" "$legacy_ephemeral_candidates" | jq '\''.[0:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; return 1; }; probe_pool_demand "$1"; printf "[]"' -- worker